# The Vercel deployment is the static site in web/ only — vercel.json points
# outputDirectory there and skips the install and build steps entirely.
#
# web/spec.js is generated from shared/eq_spec.json and committed, so the
# browser build needs nothing from the Python side at runtime.

.venv/
__pycache__/
node_modules/

# Python implementation
eqcore/
ui/
tools/
samples/
app.py
requirements.txt
pyproject.toml
run.sh

# Tests and CI
tests/
shared/
.github/
playwright.config.mjs
package.json
package-lock.json
